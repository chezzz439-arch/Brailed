<?xml version="1.0" encoding="utf-8"?>
<!-- Which USB devices auto-launch the app. CP2102 (Silicon Labs CP210x) on the
     ESP32-WROOM DevKit: VID 0x10C4 = 4292, PID 0xEA60 = 60000 (decimal, as the
     Android USB device filter requires). -->
<resources>
    <usb-device vendor-id="4292" product-id="60000" />
</resources>
