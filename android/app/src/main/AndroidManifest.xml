<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE. On Android 12+ SCAN/CONNECT are runtime perms; neverForLocation
         lets us skip location since we don't derive location from beacons. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Required for BLE scanning on API <= 30. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Live captioning of the phone's own audio (playback capture). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Android 11+ package visibility: without this we can't see/launch other
         apps (getLaunchIntentForPackage returns null). Declaring the launcher
         intent makes all launchable apps queryable, so command mode can open them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <!-- USB host (OTG) for the wired CP2102 transport. Not required — BLE is the
         fallback — so phones without USB host can still install. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".BrailedApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_edit"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Brailed">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Plugging the CP2102 in launches the app (Android auto-launches
                 an activity, not a service); MainActivity then starts the USB
                 transport. Filtered to the device by res/xml/device_filter. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Owns the BLE connection to the device and orchestrates command mode. -->
        <service
            android:name=".ble.BleService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Wired alternative: talks to the device over USB serial (CP2102). -->
        <service
            android:name=".usb.UsbSerialService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Captures the phone's playback audio for live captions. -->
        <service
            android:name=".capture.AudioCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Custom keyboard: types decoded braille into the focused field. -->
        <service
            android:name=".ime.BrailleInputMethodService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Reads on-screen text / spoken announcements (captions) and performs
             global navigation actions requested by command mode. -->
        <service
            android:name=".a11y.BrailedAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
