# byLLM reads provider API keys from the environment.
# Copy this file to .env and fill in the key for whichever model you use
# in src/commands.jac (default: claude-sonnet-4-6).

# Anthropic (Claude) — default:
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — if you switch commands.jac to Model(model_name="gpt-4o"):
# OPENAI_API_KEY=sk-...
